# 0. Preparacion --------------------------------------------------------------
# Instale readxl una sola vez si aun no esta disponible:
# install.packages("readxl")
if (!requireNamespace("readxl", quietly = TRUE)) {
stop("Falta el paquete 'readxl'. Instlelo con install.packages('readxl') y vuelva a ejecutar.")
}
# Localice el Excel junto a este script. Si se ejecuta desde RStudio con Source,
# se usa la ruta del archivo abierto; si no se detecta, se abre un selector.
argumentos <- commandArgs(trailingOnly = FALSE)
archivo_script <- grep("^--file=", argumentos, value = TRUE)
if (length(archivo_script) > 0) {
archivo_script <- sub("^--file=", "", archivo_script[1])
} else {
archivo_script <- tryCatch(sys.frame(1)$ofile, error = function(e) NULL)
}
carpeta_script <- if (!is.null(archivo_script) && length(archivo_script) == 1 && nzchar(archivo_script)) {
dirname(normalizePath(archivo_script, winslash = "/", mustWork = FALSE))
} else {
getwd()
}
archivo_excel <- file.path(carpeta_script, "Base_datos_Guia_3_calidad_agua.xlsx")
if (!file.exists(archivo_excel)) {
message("No se encontro el Excel junto al script. Seleccione Base_datos_Guia_3_calidad_agua.xlsx.")
archivo_excel <- file.choose()
}
cat("\nGUIA 3: DISENO MUESTRAL Y PREPARACION DE DATOS\n")
cat("Archivo de trabajo:", normalizePath(archivo_excel, winslash = "/"), "\n")
# 2. Importacion y reconocimiento del marco muestral -------------------------
datos <- readxl::read_excel(archivo_excel, sheet = "Datos")
variables_requeridas <- c(
"id_punto", "zona", "subcuenca", "uso_suelo", "fecha_muestreo",
"nitratos_mg_l", "ph", "turbidez_ntu", "conductividad_us_cm",
"alerta_nitratos", "seleccion_muestra"
)
faltan <- setdiff(variables_requeridas, names(datos))
if (length(faltan) > 0) {
stop("Faltan variables requeridas en la hoja Datos: ", paste(faltan, collapse = ", "))
}
cat("\n--- Poblacion, marco y unidades ---\n")
cat("Poblacion objetivo: puntos elegibles de monitoreo de la microcuenca durante la campana definida.\n")
cat("Marco muestral accesible (N):", nrow(datos), "puntos con identificador unico.\n")
cat("Unidad muestral seleccionada: cada punto de monitoreo.\n")
cat("Unidad de analisis: el punto, sobre el que se describen nitratos y otras variables.\n")
cat("Unidad de observacion: la muestra/lectura de campo o laboratorio asociada al punto.\n")
cat("Una repeticion analitica en el mismo punto no crea un nuevo punto independiente.\n")
cat("\nEstructura de los datos:\n")
print(str(datos))
cat("\nFrecuencias del marco por zona:\n")
print(table(datos$zona))
# 3. Diseno de muestreo y calculo del tamano -------------------------------
# La hoja incluye una muestra aleatoria simple sin reemplazo de 35 puntos.
# La variable zona sirve para describir cobertura, no define estratos de sorteo.
N <- nrow(datos)
n_plan <- 35L
cat("\n--- Diseno de seleccion y representacion de zonas ---\n")
cat("Muestreo aleatorio simple sin reemplazo; seleccion fija y marcada en la hoja Datos.\n")
print(table(datos$zona, datos$seleccion_muestra))
# Para una media con poblacion finita, se usa la desviacion piloto de 3.5 mg/L,
# confianza de 95% (Z=1.96) y error maximo de 1 mg/L, tal como en la presentacion.
Z <- qnorm(0.975)
sigma_piloto <- 3.5
error_media <- 1
n_media <- N * Z^2 * sigma_piloto^2 /
((N - 1) * error_media^2 + Z^2 * sigma_piloto^2)
cat("\n--- Tamano para estimar la media de nitratos ---\n")
cat("Z para 95%:", round(Z, 3), " | n calculado antes de redondear:", round(n_media, 2), "\n")
cat("La diapositiva presenta aproximadamente 34 y adopta 35 puntos; el libro usa n=35.\n")
# Para una proporcion con error de 0.10 se comparan p previa=0.30 y el caso
# conservador p=0.50. q siempre es 1-p. El redondeo se hace hacia arriba.
error_prop <- 0.10
tamano_proporcion <- function(p, N, Z, e) {
q <- 1 - p
N * Z^2 * p * q / (e^2 * (N - 1) + Z^2 * p * q)
}
n_prop_previa <- tamano_proporcion(0.30, N, Z, error_prop)
n_prop_conservadora <- tamano_proporcion(0.50, N, Z, error_prop)
cat("\n--- Tamano para estimar una proporcion (error = 0.10) ---\n")
cat("Con p=0.30 y q=0.70: n sin redondear =", round(n_prop_previa, 2),
"; n operativo =", ceiling(n_prop_previa), "\n")
cat("Sin informacion previa, p=q=0.50: n sin redondear =", round(n_prop_conservadora, 2),
"; n operativo =", ceiling(n_prop_conservadora), "\n")
cat("El tamano adoptado tambien depende de recursos y del objetivo del estudio.\n")
# Dibujo de la normal estandar y valores criticos para visualizar el nivel de
# confianza, como apoyo a la tabla de valores Z de la presentacion.
curve(dnorm(x), from = -3.5, to = 3.5, lwd = 2,
xlab = "z", ylab = "Densidad", main = "Normal estandar: confianza del 95%")
abline(v = c(-Z, Z), col = "#005B41", lty = 2, lwd = 2)
text(c(-Z, Z), y = 0.12, labels = c("-1.96", "1.96"), pos = c(2, 4), col = "#005B41")
# 4. Extraccion de la muestra y contraste de estimadores --------------------
muestra <- datos[datos$seleccion_muestra == "Si", ]
if (nrow(muestra) != n_plan) stop("La muestra marcada en el Excel no tiene 35 filas.")
if (anyDuplicated(datos$id_punto)) stop("Hay identificadores de punto duplicados en el marco.")
if (anyNA(muestra$nitratos_mg_l)) stop("Hay nitratos faltantes en la muestra; revise el registro antes de estimar.")
media_muestral <- mean(muestra$nitratos_mg_l)
sd_muestral <- sd(muestra$nitratos_mg_l)
media_marco <- mean(datos$nitratos_mg_l, na.rm = TRUE)
prop_muestral <- mean(muestra$alerta_nitratos == "Si", na.rm = TRUE)
prop_marco <- mean(datos$alerta_nitratos == "Si", na.rm = TRUE)
cat("\n--- Estadisticos de la muestra y parametros del marco sintetico ---\n")
cat("Media muestral de nitratos (x-bar):", round(media_muestral, 2), "mg/L\n")
cat("Desviacion estandar muestral (s):", round(sd_muestral, 2), "mg/L\n")
cat("Media de los 120 registros del marco (mu conocido solo por ser una simulacion):",
round(media_marco, 2), "mg/L\n")
cat("Proporcion muestral de alerta (p-hat):", round(prop_muestral, 3), "\n")
cat("Proporcion del marco sintetico:", round(prop_marco, 3), "\n")
cat("Diferencias entre muestra y marco ilustran variacion muestral; no son sesgo por si mismas.\n")
# 5. Preparacion y control de calidad ---------------------------------------
# Los hallazgos se senalan para revision. No se eliminan observaciones ni se
# reemplazan faltantes automaticamente: cada decision debe quedar justificada.
cat("\n--- Control de calidad ---\n")
cat("Filas del marco:", nrow(datos), " | IDs duplicados:", anyDuplicated(datos$id_punto), "\n")
cat("Faltantes por variable:\n")
print(sort(colSums(is.na(datos)), decreasing = TRUE))
cat("pH fuera del rango fisico 0-14:\n")
print(datos[!is.na(datos$ph) & (datos$ph < 0 | datos$ph > 14), c("id_punto", "ph")])
cat("Registros con nitratos no positivos:\n")
print(datos[!is.na(datos$nitratos_mg_l) & datos$nitratos_mg_l <= 0,
c("id_punto", "nitratos_mg_l")])
cat("Posibles valores atipicos de turbidez (regla 1.5*RIQ; revisar, no borrar):\n")
indices_atipicos <- boxplot.stats(datos$turbidez_ntu)$out
print(indices_atipicos)
cat("Conductividad faltante: revisar ficha o laboratorio; no imputar sin justificacion.\n")
# 6. Resumen para interpretar y reportar -------------------------------------
cat("\n--- Resumen descriptivo de la muestra ---\n")
print(aggregate(nitratos_mg_l ~ zona, data = muestra,
FUN = function(x) round(mean(x, na.rm = TRUE), 2)))
cat("\nFrecuencias de uso de suelo en la muestra:\n")
print(table(muestra$uso_suelo))
cat("\nLectura: reporte poblacion/marco, diseno y n; distinga x-bar y p-hat de",
"los parametros; describa los hallazgos de calidad de datos y sus limites.\n")
cat("Recuerde: el marco es sintetico y el umbral de alerta de 7.5 mg/L no representa una norma ambiental.\n")
